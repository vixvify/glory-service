{
  "name": "glory-be",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --target bun --outdir build",
    "start": "bun run build/index.js",
    "test": "bun run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@elysiajs/cors": "^1.4.2",
    "@prisma/client": "5",
    "axios": "^1.17.0",
    "elysia": "latest",
    "rate-limiter-flexible": "^11.1.1",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "prisma": "5",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "module": "src/index.js"
}
