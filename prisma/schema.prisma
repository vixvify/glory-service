datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photoUrl  String?
  motto     String?
  bio       String?
  ig        String?
  facebook  String?
  youtube   String?
  tiktok    String?
  positions String[]  @default([])
  birthday  DateTime?
  awards    String[]  @default([])

  favorites          Favorite[]
  ratings            Rating[]
  crewProfile        CrewMember?
  createdMovies      Movie[]
  createdCrewMembers CrewMember[] @relation("CreatedCrewMembers")

  @@map("users")
}

model Movie {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String  @db.Text
  thumbnail   String
  youtubeUrl  String
  trailerUrl  String?

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  releaseDate   DateTime
  duration      Int
  views         Int      @default(0)
  matchRate     Int      @default(100)
  averageRating Float    @default(0)
  aspectRatio   String   @default("landscape")

  ageRating String

  university String?
  school     String?
  language   String?

  hasProfanity Boolean  @default(false)
  hasDrugs     Boolean  @default(false)
  colorType    String
  studio       String?
  awards       String[] @default([])

  createdBy String @db.Uuid
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  favorites Favorite[]
  ratings   Rating[]
  crew      MovieCrew[]
  btsVideos String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([categoryId])
  @@index([createdBy])
  @@index([title])
  @@map("movies")
}

model CrewMember {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdBy String @db.Uuid
  creator   User   @relation("CreatedCrewMembers", fields: [createdBy], references: [id], onDelete: Cascade)

  movies MovieCrew[]

  @@index([userId])
  @@index([createdBy])
  @@map("crew_members")
}

model MovieCrew {
  id           String   @id @default(uuid()) @db.Uuid
  movieId      String   @db.Uuid
  crewMemberId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  crewRole   CrewRole   @relation(fields: [roleId], references: [id])

  @@unique([movieId, crewMemberId, roleId])
  @@index([crewMemberId])
  @@index([roleId])
  @@map("movie_crews")
}

model Favorite {
  userId    String   @db.Uuid
  movieId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, movieId])
  @@index([movieId])
  @@map("favorites")
}

model Rating {
  movieId   String   @db.Uuid
  userId    String   @db.Uuid
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("categories")
}

model CrewRole {
  id         String      @id @default(uuid()) @db.Uuid
  name       String      @unique
  createdAt  DateTime    @default(now())
  movieCrews MovieCrew[]

  @@map("crew_roles")
}
