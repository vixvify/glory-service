datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  password  String
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photoUrl  String?
  coverUrl  String?
  motto     String?
  bio       String?
  ig        String?
  facebook  String?
  youtube   String?
  tiktok    String?
  promptPay String?
  trueMoney String?
  easyDonate String?
  positions String[]  @default([])
  birthday  DateTime?
  awards    String[]  @default([])

  favorites          Favorite[]
  ratings            Rating[]
  crewProfile        CrewMember?
  createdMovies      Movie[]
  createdCrewMembers CrewMember[] @relation("CreatedCrewMembers")
  watchSessions      WatchSession[]

  @@map("users")
}

model Movie {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String  @db.Text
  thumbnail   String
  youtubeUrl  String
  trailerUrls String[] @default([])

  categories Category[]

  releaseDate   DateTime
  duration      Int
  views         Int      @default(0)
  matchRate     Int      @default(100)
  averageRating Float    @default(0)
  aspectRatio   String   @default("landscape")

  ageRatingId String    @db.Uuid
  ageRating   AgeRating @relation(fields: [ageRatingId], references: [id])

  universityId String?     @db.Uuid
  university   University? @relation(fields: [universityId], references: [id])
  schoolId     String?     @db.Uuid
  school       School?     @relation(fields: [schoolId], references: [id])
  languageId   String?     @db.Uuid
  language     Language?   @relation(fields: [languageId], references: [id])
  subtitleId   String?     @db.Uuid
  subtitle     Subtitle?   @relation(fields: [subtitleId], references: [id])

  contentWarnings     ContentWarning[]
  otherContentWarning String?
  
  colorTypeId String    @db.Uuid
  colorType   ColorType @relation(fields: [colorTypeId], references: [id])
  studio      String?
  awards      MovieAward[]
  tags        Tag[]

  createdBy String @db.Uuid
  creator   User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  favorites Favorite[]
  ratings   Rating[]
  crew      MovieCrew[]
  btsVideos String[]    @default([])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  watchSessions WatchSession[]

  @@index([createdBy])
  @@index([title])
  @@map("movies")
}

model CrewMember {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdBy String @db.Uuid
  creator   User   @relation("CreatedCrewMembers", fields: [createdBy], references: [id], onDelete: Cascade)

  movies MovieCrew[]

  @@index([userId])
  @@index([createdBy])
  @@map("crew_members")
}

model MovieCrew {
  id           String   @id @default(uuid()) @db.Uuid
  movieId      String   @db.Uuid
  crewMemberId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  crewMember CrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  crewRole   CrewRole   @relation(fields: [roleId], references: [id])

  @@unique([movieId, crewMemberId, roleId])
  @@index([crewMemberId])
  @@index([roleId])
  @@map("movie_crews")
}

model Favorite {
  userId    String   @db.Uuid
  movieId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, movieId])
  @@index([movieId])
  @@map("favorites")
}

model Rating {
  movieId   String   @db.Uuid
  userId    String   @db.Uuid
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  labelTh   String   @default("")
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("categories")
}

model CrewRole {
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @unique
  labelTh         String      @default("")
  labelEn         String      @default("")
  category        String      @default("")
  categoryLabelTh String      @default("")
  createdAt       DateTime    @default(now())
  movieCrews      MovieCrew[]

  @@map("crew_roles")
}

model MovieAward {
  id          String   @id @default(uuid()) @db.Uuid
  movieId     String   @db.Uuid
  projectName String
  awardName   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@map("movie_awards")
}

model WatchSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  movieId        String   @db.Uuid
  source         String   // "main_movie" | "trailer" | "bts"

  startSecond    Float
  endSecond      Float
  watchedSeconds Float
  duration       Float
  percentWatched Float
  completionType String   // "completed" | "paused" | "abandoned"

  pauseCount     Int      @default(0)
  replayCount    Int      @default(0)

  createdAt      DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie      Movie       @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seekEvents SeekEvent[]

  @@index([userId])
  @@index([movieId])
  @@index([userId, movieId, source])
  @@map("watch_sessions")
}

model SeekEvent {
  id             String       @id @default(uuid()) @db.Uuid
  watchSessionId String       @db.Uuid
  seekFrom       Float
  seekTo         Float
  createdAt      DateTime     @default(now())

  watchSession   WatchSession @relation(fields: [watchSessionId], references: [id], onDelete: Cascade)

  @@index([watchSessionId])
  @@index([watchSessionId, seekFrom])
  @@map("seek_events")
}

model AgeRating {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("age_ratings")
}

model University {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("universities")
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("schools")
}

model Language {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("languages")
}

model Subtitle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("subtitles")
}

model ContentWarning {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("content_warnings")
}

model ColorType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("color_types")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  movies    Movie[]

  @@map("tags")
}
